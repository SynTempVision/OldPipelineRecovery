# /etc/systemd/system/imgserv.service
[Unit]
Description=imgserv (port 2105 frame server)
After=network.target

[Service]
Type=forking
PIDFile=/run/imgserv.pid
ExecStartPre=/bin/bash -c 'if [ -f /run/imgserv.pid ]; then PID=$(cat /run/imgserv.pid 2>/dev/null); if [ -n "$PID" ] && ! ps -p "$PID" >/dev/null 2>&1; then rm -f /run/imgserv.pid; fi; fi'
ExecStart=/usr/local/bin/camera/imgserv -p 2105
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
