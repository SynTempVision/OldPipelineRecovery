# /etc/systemd/system/rtsp-seek-server.service
#
# Replaces rtsp-seek-server.sh's shell while-loop with systemd supervision.
# Type=simple (not forking) - rtsp-seek-server runs in the foreground, no
# daemonizing, so systemd tracks it directly, no PIDFile needed for
# systemd's OWN purposes.
#
# The PID file this service clears (/var/run/rtsp-seek-server.pid) is a
# SEPARATE concern from systemd's tracking - it's whatever rtsp-seek-server
# itself checks internally on startup, same bug class as imgserv's EEXIST
# issue, so it's cleared unconditionally before every start, matching the
# original wrapper script's own (unconditional, not just-if-stale) behavior.

[Unit]
Description=rtsp-seek-server (old pipeline, Seek Thermal IR camera)
After=network.target

[Service]
Type=simple
ExecStartPre=/bin/rm -f /var/run/rtsp-seek-server.pid
ExecStartPre=/usr/bin/usbreset 289d:0011
ExecStart=/usr/local/bin/camera/rtsp-seek-server -c
Restart=on-failure
RestartSec=5
User=root
StandardOutput=append:/var/log/rtsp-seek-server.log
StandardError=append:/var/log/rtsp-seek-server.log

[Install]
WantedBy=multi-user.target
